@page
@model FreelancePlatform.Areas.Identity.Pages.Admin.Reports.IndexModel
@{
    ViewData["Title"] = "Жалобы";
}

<h2>Жалобы</h2>

<table class="custom-table table-bordered table-striped">
    <thead>
        <tr>
            <th>Причина</th>
            <th>На кого</th>
            <th>От кого</th>
            <th>Статус</th>
            <th>Дата</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var report in Model.Reports)
        {
            <tr>
                <td>@GetReasonText(report.Reason.ToString())</td>
                <td>@report.ReportedId</td>
                <td>@report.ReporterId</td>
                <td>
                    <span class="badge @GetStatusClass(report.Status.ToString())">
                        @GetStatusText(report.Status.ToString())
                    </span>
                </td>
                <td>@report.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                <td>
                    <form method="get" asp-page="Details" asp-route-id="@report.Id" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-primary">Подробнее</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@functions {
    private string GetReasonText(string reason) => reason switch
    {
        "Fraud"       => "Мошенничество",
        "LateDelivery"=> "Срыв сроков",
        "PoorQuality" => "Низкое качество",
        "Spam"        => "Спам",
        "Abuse"       => "Оскорбления",
        "Other"       => "Другое",
        _             => "Неизвестно"
    };

    private string GetStatusText(string status) => status switch
    {
        "Pending"  => "На рассмотрении",
        "Resolved" => "Решена",
        "Rejected" => "Отклонена",
        _          => "Неизвестно"
    };

    private string GetStatusClass(string status) => status switch
    {
        "Pending"  => "bg-warning",
        "Resolved" => "bg-success",
        "Rejected" => "bg-danger",
        _          => "bg-secondary"
    };
}